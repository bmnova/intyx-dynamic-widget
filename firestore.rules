rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Widgets — read-only for authenticated clients, write via server only
    match /widgets/{widgetId} {
      allow read: if true;
      allow write: if false; // Managed by server API
    }

    // Trigger rules — server-managed
    match /trigger_rules/{ruleId} {
      allow read: if true;
      allow write: if false;
    }

    // User states — users can only read/write their own state
    match /user_states/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Managed by server API
    }

    // Data cache — read-only for clients
    match /data_cache/{sourceId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
