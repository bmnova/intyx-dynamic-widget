# =====================================================================
# Intyx Dynamic Widget — Web Dashboard Environment Variables
# Copy this file to .env and fill in your values.
# =====================================================================

# --- Required ---
# URL of the deployed backend server (no trailing slash)
VITE_API_URL=http://localhost:8080

# --- Paddle Payments (optional — needed for live checkout) ---
# Environment: "sandbox" for testing, "production" for live
# VITE_PADDLE_ENV=sandbox
# VITE_PADDLE_PUBLISHABLE_TOKEN=
# Comma-separated or JSON map of plan -> Paddle price ID
# VITE_PADDLE_PRICE_IDS={"pro":"pri_xxx","enterprise":"pri_yyy"}

# --- Admin Dashboard (optional) ---
# A shared secret that protects the /admin page.
# Set the same value on the server as INTYX_ADMIN_SECRET.
# Leave empty to disable the admin page entirely.
# VITE_ADMIN_SECRET=
