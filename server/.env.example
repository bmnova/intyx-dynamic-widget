# === Zorunlu ===
FIREBASE_PROJECT_ID=intyx-dynamic-widget
GEMINI_API_KEY=

# === Onerilen (production) ===
# Backend API koruma anahtari. Ornek uretim: openssl rand -hex 32
# INTYX_SERVER_API_KEY=

# Admin dashboard icin ayri gizli anahtar (web VITE_ADMIN_SECRET ile ayni olmali)
# INTYX_ADMIN_SECRET=

# Yerel gelistirme icin kimlik dogrulama atlama. PRODUCTION'DA KULLANMAYIN.
# INTYX_DEV_MODE=true

# Service account JSON dosya yolu. Cloud Run/GCP'de bos birakin (ADC kullanilir).
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# === CORS ===
# Izin verilen frontend origin'leri (virgul ile ayrilmis). Bos birakilirsa * kullanilir.
# CORS_ORIGINS=https://intyx.dev,https://www.intyx.dev

# === Opsiyonel — Veri Kaynaklari ===
# OPENWEATHER_API_KEY=
# NEWS_API_KEY=
# NEWS_API_COUNTRY=tr
# TWITTER_BEARER_TOKEN=
# TRENDS_REGION=TR

# === Opsiyonel — Odemeler ===
# PADDLE_WEBHOOK_SECRET=

# === Opsiyonel — Hata Takip ===
# SENTRY_DSN=

# === Opsiyonel — AI ===
# GEMINI_MODEL_NAME=gemini-2.0-flash

# === Opsiyonel — Server ===
# HOST=0.0.0.0
# PORT=8080
# RATE_LIMIT_DEFAULT=200 per hour
# RATE_LIMIT_AI=30 per minute

# === Opsiyonel — Polling Intervalleri (saniye) ===
# WEATHER_POLL_INTERVAL=300
# NEWS_POLL_INTERVAL=600
# HOROSCOPE_POLL_INTERVAL=3600
# TRENDS_POLL_INTERVAL=900
